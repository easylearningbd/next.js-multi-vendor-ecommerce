# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
/.env*

# user-uploaded files (local dev storage — see lib/brand-upload.ts TODO(storage))
/public/uploads/*
!/public/uploads/.gitkeep

# private uploads — TIN certificates (tax documents). NEVER commit; never served
# from /public. See lib/vendor-profile-upload.ts TODO(storage).
/private-uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
