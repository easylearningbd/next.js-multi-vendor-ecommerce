// Covet — multi-vendor marketplace auth schema
// One User table with a role enum. A VENDOR user is linked 1:1 to a Vendor (store).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

// Admin-controlled review state. New vendor products start PENDING.
enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A product's discount can be a flat amount or a percentage (design has both).
enum ProductDiscountType {
  AMOUNT
  PERCENT
}

// A vendor coupon's discount kind. `value` is a percentage for PERCENTAGE, a currency
// amount for FIXED, and ignored for FREE_SHIPPING.
enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// STORE_WIDE applies to all of the vendor's items in a cart; SPECIFIC_PRODUCTS applies
// only to the attached products (via CouponProduct).
enum CouponScope {
  STORE_WIDE
  SPECIFIC_PRODUCTS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Collected on vendor onboarding (VendorRegister design has a Phone field);
  // optional so customer/admin accounts don't require it.
  phone        String?
  // Profile photo — public path like /uploads/users/<uuid>.jpg (nullable; most
  // accounts have none). Managed by the customer dashboard profile update.
  image        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor   Vendor?
  accounts Account[]
  sessions Session[]
  orders   Order[]
  reviews  Review[]
  wishlist Wishlist[]
}

model Vendor {
  id        String       @id @default(cuid())
  userId    String       @unique
  storeName String
  slug      String       @unique
  status    VendorStatus @default(PENDING)

  // Store/vendor profile (nullable — self-registered vendors don't set these;
  // admin-created vendors do via the Add Vendor form). Images live under
  // /public/uploads/vendors/.
  image          String? // vendor/owner image
  logo           String? // shop logo
  coverImage     String? // shop cover image
  address        String? // shop address
  tinNumber      String? // taxpayer identification number
  tinExpireDate  DateTime? // TIN expiry
  tinCertificate String? // TIN certificate file path

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  coupons   Coupon[]
  subOrders SubOrder[]
}

model Brand {
  id        String      @id @default(cuid())
  name      String      @unique
  // Slug is generated from name now (not retrofitted) — needed for storefront
  // brand filtering later.
  slug      String      @unique
  image     String?
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // A product's brand is optional; deleting a brand nulls Product.brandId
  // (onDelete: SetNull on the Product side) rather than deleting products.
  products Product[]
}

// ---- Category taxonomy: Category → SubCategory → SubSubCategory ----
// Names are unique within their parent scope (so the same name can exist under a
// different parent). Parent relations use onDelete: Restrict — deletes with
// children are blocked in the app layer, never cascaded.

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories    SubCategory[]
  subSubCategories SubSubCategory[]
  // Product.categoryId is required → onDelete: Restrict on the Product side blocks
  // deleting a category that still has products (never cascade-deletes products).
  products         Product[]
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  slug       String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subSubCategories SubSubCategory[]
  products         Product[]

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@index([categoryId])
}

model SubSubCategory {
  id            String   @id @default(cuid())
  name          String
  slug          String
  categoryId    String
  subCategoryId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([subCategoryId, name])
  @@unique([subCategoryId, slug])
  @@index([categoryId])
  @@index([subCategoryId])
}

// ---- Products ----
// A product belongs to exactly one vendor (scope every query by vendorId).
// TWO independent status fields:
//   approvalStatus — admin review gate (PENDING by default for new vendor products)
//   isActive       — the vendor's own show/hide toggle
// A product is storefront-visible only when approvalStatus=APPROVED AND isActive=true.
//
// Money is ALWAYS Decimal(10,2), never Float (CLAUDE.md). taxRate is a percentage.
// `gallery` is a JSON array of image paths and each variation's `attributes` is a JSON
// map ({ Color: "Red", Size: "M" }): both are read/written wholesale with the product
// and never filtered on independently, so JSON keeps it simple (no extra join tables).
// If attribute-level faceted search is needed later, normalize then.

model Product {
  id       String @id @default(cuid())
  vendorId String

  // Taxonomy — category required; sub/sub-sub + brand optional. onDelete is chosen so
  // deleting a brand/category NEVER cascade-deletes products (see relations below).
  brandId          String?
  categoryId       String
  subCategoryId    String?
  subSubCategoryId String?

  name             String
  slug             String  @unique
  sku              String?
  shortDescription String? @db.Text
  description      String  @db.Text

  // Pricing (all Decimal). discountType says whether `discount` is a flat amount or %.
  price          Decimal             @db.Decimal(10, 2)
  compareAtPrice Decimal?            @db.Decimal(10, 2)
  discount       Decimal?            @db.Decimal(10, 2)
  discountType   ProductDiscountType @default(AMOUNT)
  taxRate        Decimal?            @db.Decimal(5, 2) // percentage

  // Simple-product stock. IGNORED when the product has variations — then the sum of
  // ProductVariation.stock is the source of truth.
  stock Int @default(0)

  thumbnail String?
  gallery   Json? // string[] of image paths

  metaTitle       String?
  metaDescription String? @db.Text

  approvalStatus ProductApprovalStatus @default(PENDING)
  isActive       Boolean               @default(true)
  // Admin-controlled storefront flags (toggled from the admin product pages).
  isFeatured     Boolean               @default(false)
  isPopular      Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor         Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  brand          Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory    SubCategory?       @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  subSubCategory SubSubCategory?    @relation(fields: [subSubCategoryId], references: [id], onDelete: Restrict)
  variations     ProductVariation[]
  couponProducts CouponProduct[]
  orderItems     OrderItem[]
  reviews        Review[]
  wishlist       Wishlist[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([brandId])
  @@index([approvalStatus])
  @@index([isFeatured])
  @@index([isPopular])
}

// One row per attribute combination (e.g. "Red / M"), each with its own price + stock.
model ProductVariation {
  id         String   @id @default(cuid())
  productId  String
  name       String // human label, e.g. "Red / M"
  sku        String?
  price      Decimal  @db.Decimal(10, 2)
  stock      Int      @default(0)
  image      String?
  attributes Json // { Color: "Red", Size: "M" }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

// ---- Coupons ----
// A coupon belongs to exactly one vendor (scope every query by vendorId). CORE RULE:
// a coupon may only ever discount ITS vendor's own line items — enforced in
// validateCoupon() server-side, never in the schema. Money is ALWAYS Decimal(10,2).
model Coupon {
  id       String @id @default(cuid())
  vendorId String

  code  String // unique PER VENDOR (see @@unique below) — two vendors can share "SAVE10"
  title String

  type  CouponType
  value Decimal    @db.Decimal(10, 2) // percentage for PERCENTAGE, amount for FIXED

  scope CouponScope @default(STORE_WIDE)

  minSpend    Decimal? @db.Decimal(10, 2) // minimum cart subtotal (this vendor's items)
  maxDiscount Decimal? @db.Decimal(10, 2) // cap for PERCENTAGE coupons

  usageLimit        Int? // total redemptions allowed (null = unlimited)
  usageLimitPerUser Int? // per-customer cap (null = unlimited)
  usedCount         Int  @default(0)

  startsAt  DateTime
  expiresAt DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products  CouponProduct[]
  subOrders SubOrder[]

  // Code is unique within a vendor, not globally.
  @@unique([vendorId, code])
  @@index([vendorId])
}

// Join table for SPECIFIC_PRODUCTS coupons ↔ the vendor's products they apply to.
model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

// ---- NextAuth adapter models (present so the Prisma adapter is satisfied;
//      sessions use JWT, so the Session table is not actively used) ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Orders — a marketplace order splits into per-vendor sub-orders.
// COD in v1; paymentMethod is enum so a STRIPE branch slots in later.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  COD
  STRIPE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// One lifecycle shared by the parent Order and each SubOrder.
enum OrderStatus {
  PENDING
  CONFIRMED
  PACKAGING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
  RETURNED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // human-readable, e.g. CVT-7F3K9A
  customerId  String

  // Shipping address snapshot (typed fields — queryable, survives profile edits).
  shipName    String
  shipEmail   String
  shipPhone   String
  shipCountry String
  shipCity    String
  shipZip     String
  shipAddress String @db.Text

  // Billing address — all null means "same as shipping".
  billName    String?
  billEmail   String?
  billPhone   String?
  billCountry String?
  billCity    String?
  billZip     String?
  billAddress String? @db.Text

  // Money — server-computed at placement (all Decimal, never float).
  subtotal   Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  tax        Decimal @default(0) @db.Decimal(10, 2)
  shipping   Decimal @default(0) @db.Decimal(10, 2)
  grandTotal Decimal @db.Decimal(10, 2)

  shippingMethod String? // simple flat method label for now

  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  status        OrderStatus   @default(PENDING)

  note      String?  @db.Text
  // Soft-hide from the CUSTOMER's own order list ("Hide from my list"). The order
  // record stays fully intact for sales/vendor/reporting; null = visible.
  hiddenAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: a customer with orders cannot be hard-deleted (order history is kept).
  customer  User       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subOrders SubOrder[]

  @@index([customerId])
  @@index([createdAt])
}

model SubOrder {
  id       String @id @default(cuid())
  orderId  String
  vendorId String

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  couponId String? // the vendor coupon applied to THIS sub-order, if any

  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  coupon Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  OrderItem[]

  @@index([orderId])
  @@index([vendorId])
}

model OrderItem {
  id          String  @id @default(cuid())
  subOrderId  String
  productId   String
  variationId String?

  // Snapshots — order history survives later product/price edits or deletion.
  productName  String
  variantLabel String?
  unitPrice    Decimal @db.Decimal(10, 2)
  qty          Int
  lineTotal    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  subOrder  SubOrder          @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  // Restrict: a product referenced by orders is deactivated, not hard-deleted.
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variation ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  reviews   Review[]

  @@index([subOrderId])
  @@index([productId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A verified-buyer product review. `orderItemId` ties the review to a real
/// purchased line, so only genuine buyers can review. Reviews start PENDING and
/// are shown on the storefront only once an admin APPROVES them.
model Review {
  id          String @id @default(cuid())
  productId   String
  customerId  String
  orderItemId String

  rating  Int // 1–5, enforced in the server action + zod
  title   String?
  comment String  @db.Text
  images  Json? // optional string[] of uploaded image paths

  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  // Cascade: a review is dependent data — it goes if the product, customer, or the
  // purchased line it belongs to is ever removed.
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer  User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // One review per purchased line item — a customer can't review the same purchase twice.
  @@unique([customerId, orderItemId])
  @@index([productId])
  @@index([customerId])
  @@index([status])
}

/// A customer's saved (wishlisted) product. Login-required; one row per
/// (customer, product) — a product can't be wishlisted twice by one user.
model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  // Cascade: a wishlist row is dependent data — it goes if the customer or the
  // product it points to is ever removed.
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}
