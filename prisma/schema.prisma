// Covet — multi-vendor marketplace auth schema
// One User table with a role enum. A VENDOR user is linked 1:1 to a Vendor (store).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Collected on vendor onboarding (VendorRegister design has a Phone field);
  // optional so customer/admin accounts don't require it.
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor   Vendor?
  accounts Account[]
  sessions Session[]
}

model Vendor {
  id        String       @id @default(cuid())
  userId    String       @unique
  storeName String
  slug      String       @unique
  status    VendorStatus @default(PENDING)

  // Store/vendor profile (nullable — self-registered vendors don't set these;
  // admin-created vendors do via the Add Vendor form). Images live under
  // /public/uploads/vendors/.
  image          String? // vendor/owner image
  logo           String? // shop logo
  coverImage     String? // shop cover image
  address        String? // shop address
  tinNumber      String? // taxpayer identification number
  tinExpireDate  DateTime? // TIN expiry
  tinCertificate String? // TIN certificate file path

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id        String      @id @default(cuid())
  name      String      @unique
  // Slug is generated from name now (not retrofitted) — needed for storefront
  // brand filtering later.
  slug      String      @unique
  image     String?
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // TODO(product): when the Product model is added, add the back-relation:
  //   products Product[]
  // and Product should carry `brandId String?` + `brand Brand? @relation(...)`.
  // Until then, a brand's product count is 0 and delete is always allowed.
}

// ---- Category taxonomy: Category → SubCategory → SubSubCategory ----
// Names are unique within their parent scope (so the same name can exist under a
// different parent). Parent relations use onDelete: Restrict — deletes with
// children are blocked in the app layer, never cascaded.

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories    SubCategory[]
  subSubCategories SubSubCategory[]
  // TODO(product): when the Product model exists, add `products Product[]` here and
  // count via Prisma _count. Until then product counts are computed as 0.
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  slug       String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subSubCategories SubSubCategory[]
  // TODO(product): products Product[] (via Product.subCategoryId) — computed count only.

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@index([categoryId])
}

model SubSubCategory {
  id            String   @id @default(cuid())
  name          String
  slug          String
  categoryId    String
  subCategoryId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  // TODO(product): products Product[] (via Product.subSubCategoryId) — computed count only.

  @@unique([subCategoryId, name])
  @@unique([subCategoryId, slug])
  @@index([categoryId])
  @@index([subCategoryId])
}

// ---- NextAuth adapter models (present so the Prisma adapter is satisfied;
//      sessions use JWT, so the Session table is not actively used) ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
